#!/bin/sh
# Auto-format Rust before every commit so CI `cargo fmt --check` never fails.
set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

command -v cargo >/dev/null 2>&1 || exit 0
[ -f Cargo.toml ] || exit 0

cargo fmt --all

# Re-stage Rust files that rustfmt updated
git diff --name-only | while IFS= read -r file; do
  case "$file" in
    *.rs) git add "$file" ;;
  esac
done

exit 0
