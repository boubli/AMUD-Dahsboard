# AMUD Dashboard Configuration Environment Variables

# Web Server Settings
PORT=8000
BIND_ADDR=127.0.0.1 # Use 0.0.0.0 for Docker or public visibility

# SQLite Database Location
DB_PATH=data/amud.db

# Security & Session Settings
AMUD_TRUST_PROXY=0   # Set to 1 to trust X-Forwarded-For/X-Real-IP reverse proxy headers
AMUD_SECURE_COOKIES=0 # Set to 1 to enforce Secure cookies (requires HTTPS)
AMUD_SECRETS_KEY=     # 32-byte hex encryption key for credentials at rest (autogenerated if empty)

# Agent IPC Settings
AMUD_AGENT_SECRET=    # Shared secret key between Server and Agent (autogenerated if empty)
AMUD_TCP_ADDR=127.0.0.1:8050 # TCP address for loopback communication
# AMUD_SOCKET_PATH=/opt/amud/run/amud.sock # Unix Domain Socket path (alternative to TCP)

# Proxmox LXC Integration (Server-side Toggle)
AMUD_ENABLE_PROXMOX=false

# ----------------------------------------------------
# AMUD Agent Daemon Configuration (Run on host/PVE)
# ----------------------------------------------------
# PVE_API_TOKEN=root@pam!tokenname=uuid-token-secret
# PVE_NODE=proxmox-node-name
# AMUD_DOCKER=0
