#!/bin/sh
# Run the same checks as GitHub CI before every push.
set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

if command -v bash >/dev/null 2>&1 && [ -f scripts/ci-check.sh ]; then
  bash scripts/ci-check.sh
elif [ -f scripts/ci-check.ps1 ]; then
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ci-check.ps1
else
  echo "pre-push: scripts/ci-check not found; skipping"
fi
